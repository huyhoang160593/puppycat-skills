{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "*.ts"
  ],
  "typeAcquisition": {
    "enable": true,
    "include": [
      "node"
    ]
  },
}